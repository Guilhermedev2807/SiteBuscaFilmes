{
  "buildCommand": "mkdir -p public && cp style.css public/",
  "outputDirectory": "public",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "*.php"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/detalhes.php", "destination": "/api/detalhes.php" }
  ]
}